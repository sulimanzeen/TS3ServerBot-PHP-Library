# Copy to `.env` in this same folder (next to README.md / composer.json).
# Never commit `.env`.
#
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (macOS / Linux)
#

# --- Connection ----------------------------------------------------------
# Hostname or IP of the TeamSpeak instance (not a voice client).
TS_HOST=127.0.0.1

# webquery  = HTTP JSON on TS_WEBQUERY_PORT (needs TS_API_KEY)
# ssh       = encrypted ServerQuery on TS_SSH_PORT (needs user + password)
TS_TRANSPORT=webquery

# ts3  = TeamSpeak 3.13.8 catalog (default)
# ts6  = TeamSpeak 6.0.0-beta12.1 catalog
TS_FAMILY=ts3

# Seconds for SSH I/O and WebQuery HTTP.
TS_TIMEOUT=10

# --- Ports (TeamSpeak 3.13.8 / 6 defaults) --------------------------------
TS_SSH_PORT=10022
TS_WEBQUERY_PORT=10080

# true if WebQuery is behind HTTPS (reverse proxy). Native TeamSpeak HTTPS
# Query on 10443 is not claimed by this library.
TS_WEBQUERY_TLS=false
TS_VERIFY_TLS=true

# --- Virtual server ------------------------------------------------------
TS_VIRTUAL_SERVER_ID=1
# Voice port. Optional; used for use port= / WebQuery /byport/.
TS_VIRTUAL_SERVER_PORT=9987
# Query nickname sent with SSH `use` when a virtual server is selected.
TS_NICKNAME=TS3ServerBot

# --- WebQuery ------------------------------------------------------------
# Create with apikeyadd over SSH, or copy from the server panel.
# Sent only as header x-api-key (never in the URL).
TS_API_KEY=

# --- SSH Query -----------------------------------------------------------
# These are Query credentials. The SSH handshake is Query login —
# you do not call $client->login() afterward unless you switch identity.
TS_QUERY_USER=serveradmin
TS_QUERY_PASSWORD=

# Optional SHA-256 fingerprint of the SSH host key. Mismatch fails connect.
TS_SSH_HOST_FINGERPRINT=
