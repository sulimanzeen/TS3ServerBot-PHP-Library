{
  "name": "ts3serverbot/query",
  "description": "Open-source PHP Query client for TeamSpeak 3 and TeamSpeak 6 over SSH and WebQuery. Developed under TS3ServerBot.com.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://ts3serverbot.com",
    "keywords": ["teamspeak", "teamspeak3", "teamspeak6", "serverquery", "webquery", "ssh", "ts3serverbot"],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "TS3ServerBot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TS3ServerBot\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "docs": "php bin/docs-serve.php",
        "docs:build": "php bin/docs-build.php",
        "docs:validate": "php bin/validate-docs.php",
        "catalog": "php bin/generate-catalog.php"
    },
    "minimum-stability": "stable"
}
